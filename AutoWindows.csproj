<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 22000 (Win11) — enables WinRT types in the SDK without extra packages -->
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms for NotifyIcon (system tray) and System.Drawing screen capture -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Auto</AssemblyName>
    <RootNamespace>Auto</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Per-monitor DPI v2 — WPF handles this; must NOT also be in app.manifest -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real-time WASAPI audio capture (mic only in this build — no MP3 playback) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />

    <!-- Whisper.net + Whisper.net.Runtime (CPU) come in transitively via Auto.Core.
         This adds the CUDA native runtime on top: Whisper.net picks it automatically
         when an NVIDIA GPU + driver are present, falling back to CPU otherwise — no
         code change needed either way. Windows-only; macOS has no CUDA. -->
    <PackageReference Include="Whisper.net.Runtime.Cuda" Version="1.7.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Auto.Core\Auto.Core.csproj" />
  </ItemGroup>

  <!-- Auto.Core is a subfolder of this project's own directory (nested in the same git
       repo), so the default **/*.cs glob above would otherwise compile its source files
       directly into this assembly too, on top of the ProjectReference above — same types
       compiled twice, ambiguous-type errors. Exclude it explicitly. -->
  <ItemGroup>
    <Compile Remove="Auto.Core\**\*.cs" />
    <Compile Remove="Auto.Mac\**\*.cs" />
    <Compile Remove="Auto.Server\**\*.cs" />
  </ItemGroup>

</Project>
