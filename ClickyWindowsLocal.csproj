<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Win10 22000 (Win11) — enables WinRT types in the SDK without extra packages -->
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms for NotifyIcon (system tray) and System.Drawing screen capture -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ClickyWindowsLocal</AssemblyName>
    <RootNamespace>ClickyWindows</RootNamespace>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Per-monitor DPI v2 — WPF handles this; must NOT also be in app.manifest -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real-time WASAPI audio capture (mic only in this build — no MP3 playback) -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />

    <!-- Offline speech-to-text (whisper.cpp bindings) — replaces AssemblyAI.
         Runtime picks CPU inference by default; swap to Whisper.net.Runtime.Cuda
         (NVIDIA) if the machine has a CUDA GPU, see README. -->
    <PackageReference Include="Whisper.net" Version="1.7.4" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.7.4" />

    <!-- Offline text-to-speech via SAPI (Windows' built-in speech engine) — replaces
         ElevenLabs. Uses whatever voice is installed/selected in Windows Settings, no
         model download, no network call. -->
    <PackageReference Include="System.Speech" Version="8.0.0" />
  </ItemGroup>

</Project>
