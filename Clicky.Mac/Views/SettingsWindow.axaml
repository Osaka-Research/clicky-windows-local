<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClickyMac.Views.SettingsWindow"
        Title="Auto Settings"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#15161B">

    <StackPanel Margin="20" Spacing="12">
        <TextBlock Text="Auto Settings" FontSize="16" FontWeight="Bold" Foreground="#ECEEED"/>

        <StackPanel Spacing="4">
            <TextBlock Text="Anthropic API key" Foreground="#8A8F98" FontSize="12"/>
            <TextBox x:Name="ApiKeyBox" Watermark="sk-ant-..." PasswordChar="•"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Claude model" Foreground="#8A8F98" FontSize="12"/>
            <TextBox x:Name="ModelBox"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Proxy URL (optional -- leave blank to call Anthropic directly)" Foreground="#8A8F98" FontSize="12"/>
            <TextBox x:Name="ProxyUrlBox"/>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="Whisper model size" Foreground="#8A8F98" FontSize="12"/>
            <ComboBox x:Name="WhisperModelBox" HorizontalAlignment="Stretch">
                <ComboBoxItem>tiny</ComboBoxItem>
                <ComboBoxItem>tiny.en</ComboBoxItem>
                <ComboBoxItem>base</ComboBoxItem>
                <ComboBoxItem>base.en</ComboBoxItem>
                <ComboBoxItem>small</ComboBoxItem>
                <ComboBoxItem>small.en</ComboBoxItem>
                <ComboBoxItem>medium</ComboBoxItem>
                <ComboBoxItem>medium.en</ComboBoxItem>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="System Audio input device (for a virtual device like BlackHole -- optional)" Foreground="#8A8F98" FontSize="12" TextWrapping="Wrap"/>
            <TextBox x:Name="SystemAudioDeviceBox" Watermark="BlackHole 2ch"/>
        </StackPanel>

        <CheckBox x:Name="UseRemoteServerBox" Content="Use a remote Auto server instead (no GPU / no API key needed here)"
                  Foreground="#ECEEED" IsCheckedChanged="OnRemoteServerToggled"/>

        <StackPanel x:Name="RemoteServerPanel" Spacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="Server URL" Foreground="#8A8F98" FontSize="12"/>
                <TextBox x:Name="RemoteServerUrlBox" Watermark="https://clicky.example.com"/>
            </StackPanel>
            <StackPanel Spacing="4">
                <TextBlock Text="Server token" Foreground="#8A8F98" FontSize="12"/>
                <TextBox x:Name="RemoteServerTokenBox" PasswordChar="•"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel"/>
            <Button x:Name="SaveButton" Content="Save" Click="OnSave" Background="#7C8AFF" Foreground="White"/>
        </StackPanel>
    </StackPanel>
</Window>
