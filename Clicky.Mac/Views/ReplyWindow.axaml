<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClickyMac.Views.ReplyWindow"
        Title="Clicky"
        Width="460"
        SizeToContent="Height"
        MaxHeight="480"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        CanResize="False"
        WindowStartupLocation="Manual">

    <Border Background="#EE101211"
            CornerRadius="10"
            BorderBrush="#332B63FF"
            BorderThickness="1"
            Padding="16,12"
            BoxShadow="0 4 20 0 #66000000">

        <Grid RowDefinitions="Auto,Auto,Auto">

            <Grid Grid.Row="0" Margin="0,0,0,8" ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ModeLabel" Grid.Column="0" Text="Clicky" Foreground="#7C8AFF" FontSize="12" FontWeight="Bold"/>
                <Button x:Name="CloseButton" Grid.Column="1" Content="&#x2715;"
                        Background="Transparent" BorderThickness="0" Foreground="#888888"
                        Padding="4,0" FontSize="12" Click="OnClose" Cursor="Hand"/>
            </Grid>

            <TextBlock x:Name="TranscriptText"
                       Grid.Row="1"
                       Foreground="#8A8F98"
                       FontSize="13"
                       FontStyle="Italic"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="420">
                <TextBlock x:Name="ReplyText"
                           Foreground="#ECEEED"
                           FontSize="19"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           LineHeight="27"/>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
